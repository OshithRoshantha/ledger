# Copy to .env and fill in. Never commit .env.

# ---- public site
DOMAIN=ledger.example.com
ACME_EMAIL=you@example.com

# ---- secrets (generate fresh values!)
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENC_KEY=

# ---- database: MongoDB Atlas (default)
# Use a DEDICATED Atlas database user with only "readWrite@ledger" (not an admin role),
# and allow only your VPS IP under Atlas -> Network Access.
# URL-encode special characters in the password (e.g. @ -> %40, : -> %3A, / -> %2F).
MONGO_URL=mongodb+srv://ledger_app:<db_password>@cluster0.17mul.mongodb.net/ledger?retryWrites=true&w=majority&appName=Cluster0
MONGO_DB=ledger

# ---- OR: MongoDB on the VPS (uncomment all of these, comment out the Atlas MONGO_URL)
# COMPOSE_PROFILES=local-db
# MONGO_INITDB_ROOT_USERNAME=root
# MONGO_INITDB_ROOT_PASSWORD=
# MONGO_APP_USER=ledger
# MONGO_APP_PASSWORD=
# MONGO_URL=mongodb://ledger:<MONGO_APP_PASSWORD>@mongo:27017/ledger?authSource=ledger

# ---- app defaults (change later in Settings -> Income & Cycle)
DEFAULT_TIMEZONE=Asia/Colombo
DEFAULT_SALARY_DAY=5

# Keep true in production (cookies only over HTTPS). Set false only for local http dev.
COOKIE_SECURE=true
